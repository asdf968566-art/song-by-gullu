# Production: Caddy gets and renews the HTTPS certificate automatically.
# Replace chat.example.com with your domain (its DNS must point to this server).
chat.example.com {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	@api path /api/* /files/* /socket.io/* /healthz /readyz
	handle @api {
		reverse_proxy server:4000
	}
	handle {
		reverse_proxy web:3000
	}
}
