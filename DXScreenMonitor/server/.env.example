# Copy to .env and fill in. Real environment variables override this file.

# Port (plain HTTP; put a TLS proxy / Cloudflare Tunnel in front, or set the two TLS paths below).
DX_PORT=8443

# TLS (optional: for the server to serve HTTPS/WSS itself, e.g. a self-signed cert on a LAN).
# DX_TLS_CERT=/etc/dx/cert.pem
# DX_TLS_KEY=/etc/dx/key.pem

# Shared secret every department phone uses to register. Make it long and random.
DX_DEVICE_TOKEN=change-me-device-xxxxxxxxxxxxxxxx

# Secret a viewer (dashboard / browser) needs to watch.
DX_VIEWER_TOKEN=change-me-viewer-xxxxxxxxxxxxxxxx

# STUN (free). Enough on many networks for discovery.
DX_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN (needed when the phone is on mobile data / strict NAT, e.g. some Jio connections).
# Run coturn with: static-auth-secret=<the same secret>, realm=<your domain>.
# DX_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# DX_TURN_SECRET=the-same-static-auth-secret-as-coturn
# DX_TURN_TTL=3600
